{
  "name": "go-office",
  "image": "mcr.microsoft.com/devcontainers/go:1.27-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "containerEnv": {
    "CGO_ENABLED": "0"
  },

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "go-office server",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends dpkg file && make setup",

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-playwright.playwright",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
