# Shrink build context — only explicit COPY paths in _docker/Dockerfile are used.
.git
.github
bin/*
!bin/go-office
!bin/playwright-limits

# Not needed for the demo image build (Playwright Dockerfiles copy selectively)
frontend/*
!frontend/package.json
!frontend/package-lock.json
!frontend/playwright.config.ts
!frontend/tests/
integration/
cache/
testdata/.work/
.test-cache/
doctor-report.txt
debug-*.log
**/*.md
!sample-files/README.md

# Extra cmds / tests (sources are copied selectively in the Dockerfile)
cmd/doctor/
cmd/test-x2t/
**/*_test.go
