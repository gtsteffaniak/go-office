# Binaries
/bin/
/go-office
/cmd/go-office/go-office
*.exe

# Test / dev artifacts
/cache/
testdata/.work/
.test-cache/
*.test
coverage.out

# Workspace-local Go build/temp dirs (used when GOCACHE is read-only)
/.gocache/
/.gotmp/

# Workspace-local Node/Playwright tooling dirs (used when the default caches are read-only)
/.npmcache/
/.pw-browsers/

# IDE
.idea/
.vscode/
*.swp

# Euro-Office assets (not vendored in this repo; populated by scripts/fetch-assets.*)
/assets/*
!/assets/.gitkeep

# Playwright
frontend/node_modules/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.cache/
sample-files/playwright/
