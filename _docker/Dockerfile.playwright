# Playwright demo server image (tests run via scripts/run-playwright.sh on host or in CI).
#
#   make test-playwright-ui    → server in Docker, tests on host
#   make test-playwright       → full E2E via docker run + scripts/run-playwright.sh
#
# Browser/tooling base (pin digest in Makefile; arm64 shown here for CI).

ARG PLAYWRIGHT_BASE_IMAGE=ghcr.io/gtsteffaniak/playwright-base:chromium
FROM ${PLAYWRIGHT_BASE_IMAGE} AS base
WORKDIR /app

LABEL org.opencontainers.image.source="https://github.com/quantumx-apps/go-office" \
      org.opencontainers.image.licenses="AGPL-3.0"

COPY bin/go-office ./go-office
COPY assets/ ./assets/
COPY sample-files/ ./sample-files/

RUN chmod +x /app/go-office /app/assets/converter/bin/* 2>/dev/null || true

ENV OFFICE_ASSETS=/app/assets \
    OFFICE_DEBUG_LOGGING=1 \
    OFFICE_POLL_HOLD=0 \
    OFFICE_CONVERT_LIMIT=4 \
    OFFICE_SAVE_DELAY=500ms \
    PLAYWRIGHT_BASE_URL=http://127.0.0.1:8080 \
    PLAYWRIGHT_STRICT=1

FROM base AS server
EXPOSE 8080
ENTRYPOINT ["./go-office", \
  "-assets", "/app/assets", \
  "-addr", ":8080", \
  "-data", "/app", \
  "-samples", "sample-files", \
  "-public", "http://127.0.0.1:8080"]
